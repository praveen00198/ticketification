# ==============================================================================
# Ticketification — Unified Environment Configuration Reference
# ==============================================================================
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173

# Database (Supabase IPv4 Connection Pooler - Required for Render / Vercel)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Supabase Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=ticket-images

# Frontend
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
