# ==============================================================================
# Ticketification — Unified Environment Configuration Reference
# Placeholders only. NEVER commit real production secrets or connection strings.
# ==============================================================================
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database — MongoDB (Target Core Architecture for Event Lifecycle, Roles, Rubrics)
MONGODB_URI=mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/ticketification?retryWrites=true&w=majority

# Database — PostgreSQL (Retained Drizzle ORM Schema for Legacy Operations)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# JWT Secret (Mandatory in production; minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_signing_secret

# Supabase Credentials (Preserved Storage & Optional Auth)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=ticket-images

# Platform Administration
INITIAL_ADMIN_EMAILS=admin@ticketification.com

# Puppeteer PDF Rasterization
PUPPETEER_HEADLESS=true

# Frontend Configuration (Exposed to browser via Vite - NEVER place secrets here)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
