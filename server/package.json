{
  "name": "qr-ticket-server",
  "version": "2.0.0",
  "description": "QR Ticket Generation & Verification Platform - Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx puppeteer browsers install chrome && tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --detectOpenHandles",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.39.0",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "postgres": "^3.4.5",
    "puppeteer": "^22.13.0",
    "qrcode": "^1.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0"
  }
