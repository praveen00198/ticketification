# Server Environment Variables
NODE_ENV=production
PORT=5000

# Required in production on Render (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ticketification?retryWrites=true&w=majority

# Required in production (Generate a strong random string)
JWT_SECRET=replace_with_a_strong_random_secret_32_characters_long
JWT_EXPIRES_IN=1d

# Frontend URL for CORS (e.g. your Vercel domain)
APP_URL=https://ticketification.vercel.app
CORS_ORIGIN=https://ticketification.vercel.app

UPLOAD_DIR=uploads
PUPPETEER_HEADLESS=true

# ========== Optional Delivery Providers ==========
DELIVERY_PROVIDER=email
RESEND_API_KEY=
EMAIL_FROM=tickets@example.com

WHATSAPP_ENABLED=false
WHATSAPP_MOCK=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TICKET_TEMPLATE_NAME=event_ticket
WHATSAPP_TICKET_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

WHATSAPP_BATCH_SIZE=20
WHATSAPP_CONCURRENCY=5
WHATSAPP_DELAY_MS=200

# Base URL for static ticket files (Render sets RENDER_EXTERNAL_URL automatically)
TICKET_STORAGE_PROVIDER=local
TICKET_STORAGE_BASE_URL=https://ticketification.onrender.com
