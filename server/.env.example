NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/qr_ticket_db

JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=1d

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=tickets@example.com

APP_URL=http://localhost:5173

UPLOAD_DIR=uploads

PUPPETEER_HEADLESS=true

# ========== Delivery Provider ==========
# Options: whatsapp | email
DELIVERY_PROVIDER=whatsapp

# ========== WhatsApp Business Cloud API ==========
WHATSAPP_ENABLED=false
WHATSAPP_MOCK=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TICKET_TEMPLATE_NAME=event_ticket
WHATSAPP_TICKET_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

# ========== Bulk Delivery Throttling ==========
WHATSAPP_BATCH_SIZE=20
WHATSAPP_CONCURRENCY=5
WHATSAPP_DELAY_MS=200

# ========== Ticket Storage ==========
TICKET_STORAGE_PROVIDER=local
TICKET_STORAGE_BASE_URL=http://localhost:3000
