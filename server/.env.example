# ==============================================================================
# Ticketification — Backend Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000

# Authoritative Application Database (MongoDB — Sole Source of Truth for Users & Data)
MONGODB_URI=mongodb+srv://[USER]:[PASSWORD]@[CLUSTER].mongodb.net/ticketification?retryWrites=true&w=majority

# Custom Authentication JWT Secret (Mandatory in production; minimum 32 characters)
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-chars
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Controlled Administrator Bootstrap Allowlist
INITIAL_ADMIN_EMAILS=admin@ticketification.app

# Supabase Object Storage (Used EXCLUSIVELY for file/object storage; Auth is removed)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=ticket-images

# PostgreSQL Connection String for Drizzle ORM (Optional legacy analytics / migration pool)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres

# Application & CORS
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# File Upload & Puppeteer
UPLOAD_DIR=uploads
PUPPETEER_HEADLESS=true

# Resend Email Service
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=Ticketification <onboarding@resend.dev>
