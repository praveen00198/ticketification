# ==============================================================================
# Ticketification — Backend Environment Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String for Drizzle ORM
# (Use Transaction Pooler URL from Supabase Database settings on port 5432 or 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Auth & Storage
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_BUCKET=ticket-images

# Application & CORS
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# File Upload & Puppeteer
UPLOAD_DIR=uploads
PUPPETEER_HEADLESS=true
